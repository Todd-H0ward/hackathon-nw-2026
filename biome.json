{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": ["src/**", "*.json", "*.ts", "*.js", "index.html"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "quoteStyle": "single"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "natural",
            "sortBareImports": true,
            "groups": [
              [":NODE:", ":BUN:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",
              [
                "react",
                "react-dom",
                "react-dom/**",
                "react-router",
                "react-router/**"
              ],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ["@/components", "@/components/**"],
              ":BLANK_LINE:",
              ["@/contexts", "@/contexts/**"],
              ":BLANK_LINE:",
              ["@/pages", "@/pages/**"],
              ":BLANK_LINE:",
              ["@/shared", "@/shared/**"],
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              [":PATH:", "!**/*.css", "!**/*.scss", "!**/*.sass", "!**/*.less"],
              ":BLANK_LINE:",
              ":STYLE:"
            ]
          }
        }
      }
    }
  }
}
